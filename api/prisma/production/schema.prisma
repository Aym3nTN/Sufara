  openingHours    OpeningHour[]
  savedBy         SavedPlace[]
  itineraryStops  ItineraryStop[]

  @@unique([cityId, slug])
  @@index([cityId, status])
  @@index([countryId])
  @@index([primaryCategoryId])
}

model PlaceCategory {
  placeId    String
  categoryId String

  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([categoryId])
}

model Photo {
  id           String   @id @default(cuid())
  placeId      String
  storageKey   String
  url          String
  thumbnailUrl String?
  caption      String?
  isPrimary    Boolean  @default(false)
  sortOrder    Int      @default(0)
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
}

/// Minutes from local midnight. dayOfWeek: 0 = Sunday .. 6 = Saturday.
model OpeningHour {
  id            String  @id @default(cuid())
  placeId       String
  dayOfWeek     Int
  opensMinutes  Int
  closesMinutes Int
  isClosed      Boolean @default(false)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek])
  @@index([placeId])
}

