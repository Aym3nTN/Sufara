# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
# Local development and tests use SQLite, so no database server is needed.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# In production (Neon), set:
#   DATABASE_PROVIDER=postgresql
#   DATABASE_URL   = the POOLED Neon URL   (host contains "-pooler")
#   DIRECT_URL     = the DIRECT Neon URL   (migrations only)
# Both require ?sslmode=require. See docs/DEPLOYMENT.md.
# DIRECT_URL=

# --- Auth -------------------------------------------------------------------
# The API refuses to boot in production while these hold their default values.
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Routing provider: haversine | osrm -------------------------------------
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=https://router.project-osrm.org

# --- Storage: local | r2 ----------------------------------------------------
# "local" is for development only: a deployed container's filesystem is
# recycled, so production must use r2 or uploads are lost.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Cloudflare R2 — required when STORAGE_PROVIDER=r2. Never commit real values.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# --- Seeding ----------------------------------------------------------------
# Password for the two demo accounts the seed creates. There is no default: a
# hardcoded one would be a live credential for every deployment. Leave it unset
# and the seed generates a strong password and prints it once.
# SEED_PASSWORD=

# --- Planner tuning ---------------------------------------------------------
PLANNER_BUFFER_RATIO=0.08
PLANNER_MIN_BUFFER_MINUTES=10
PLANNER_MAX_BUFFER_MINUTES=30
